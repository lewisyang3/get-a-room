# Base URL of the Get a Room API (get-a-room-api). Vite only exposes variables
# prefixed with VITE_ to the browser, and reads them at build time.
VITE_API_BASE_URL=http://localhost:8000

# The term to search, as its term_id in the API's database. Find it with
# `python -m ingestion.cli term list` in get-a-room-api. Search is disabled
# until this is set.
VITE_TERM_ID=

# A Mapbox public access token (starts with pk.) for the campus map. Create one
# at https://account.mapbox.com/access-tokens and, for a deployed site, limit it
# to that site's URLs. Search is disabled until this is set.
VITE_MAPBOX_TOKEN=
