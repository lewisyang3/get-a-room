# Postgres credentials used by docker-compose to create the db container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=get_a_room

# Used by the api service / local runs (docker-compose overrides this to point at the db service)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/get_a_room

APP_ENV=local
ALLOWED_ORIGINS=http://localhost:3000

SCRAPER_RATE_LIMIT_SECONDS=1.0
SCRAPER_TIMEOUT_SECONDS=30.0
SCRAPER_USER_AGENT=GetARoomBot/0.1 (+https://github.com/get-a-room-berkeley/get-a-room-api; polite academic-schedule scraper)
